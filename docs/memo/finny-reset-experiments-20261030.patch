+#if defined(NNUE_FT_COMPACT)
+	// Keep the existing doubled int16 accumulator. Only the stored columns change:
+	// doubled_weight = 2 * int8_base + exact sparse int32 residual.
+	void compact_weights() {
+		const std::size_t count = std::size_t(kHalfDimensions) * kInputDimensions;
+		compact_base_ = make_unique_large_page<std::int8_t[]>(count);
+		compact_masks_ = make_unique_large_page<std::uint32_t[]>(count / 32);
+		compact_tile_offsets_ = make_unique_large_page<std::uint32_t[]>(count / kTileHeight);
+		std::vector<std::int32_t> residuals;
+		for (std::size_t i = 0; i < count; ++i) {
+			if (i % kTileHeight == 0)
+				compact_tile_offsets_[i / kTileHeight] = residuals.size();
+			const int base = std::clamp(int(weights_[i]) / 2, -128, 127);
+			compact_base_[i] = static_cast<std::int8_t>(base);
+			const int residual = int(weights_[i]) - 2 * base;
+			if (residual) {
+				compact_masks_[i / 32] |= std::uint32_t(1) << (i % 32);
+				residuals.push_back(residual);
+			}
+		}
+		compact_residuals_ = make_unique_large_page<std::int32_t[]>(std::max(residuals.size(), std::size_t(1)));
+		std::copy(residuals.begin(), residuals.end(), compact_residuals_.get());
+		// Check every reconstructed weight against the original before releasing it.
+		std::size_t r = 0;
+		for (std::size_t i = 0; i < count; ++i) {
+			int value = 2 * int(compact_base_[i]);
+			if (compact_masks_[i / 32] & (std::uint32_t(1) << (i % 32)))
+				value += compact_residuals_[r++];
+			if (value != weights_[i])
+				std::abort();
+		}
+		std::vector<WeightType>().swap(weight_storage_);
+		weights_ = nullptr;
+	}
+
+#if defined(NNUE_FT_COMPACT_UNROLL)
+	[[gnu::always_inline]]
+#endif
+	vec_t load_compact_chunk(IndexType index, IndexType offset,
+	                         const std::int32_t*& residual) const {
+		const std::size_t start = std::size_t(index) * kHalfDimensions + offset;
+		vec_t w = _mm512_slli_epi16(_mm512_cvtepi8_epi16(
+		    _mm256_loadu_si256(reinterpret_cast<const __m256i*>(compact_base_.get() + start))), 1);
+		const std::uint32_t mask = compact_masks_[start / 32];
+		if (mask) {
+			const auto low_mask = static_cast<__mmask16>(mask);
+			const auto high_mask = static_cast<__mmask16>(mask >> 16);
+			const auto lo = _mm512_cvtepi32_epi16(_mm512_maskz_expandloadu_epi32(low_mask, residual));
+			residual += __builtin_popcount(unsigned(low_mask));
+			const auto hi = _mm512_cvtepi32_epi16(_mm512_maskz_expandloadu_epi32(high_mask, residual));
+			residual += __builtin_popcount(unsigned(high_mask));
+			w = _mm512_add_epi16(w,
+			    _mm512_inserti64x4(_mm512_castsi256_si512(lo), hi, 1));
+		}
+		return w;
+	}
+#endif
+
